# Add this line to <webroot>/.env (the signcollect-lib env file, mode 640,
# group www-data; never in git). Generate a value with: openssl rand -hex 24
# Put the same value in VIDEOFIX_TOKEN in signlab_drs-pipeline's .env.
# Without it (or the same name in the process environment) api.php refuses
# every X-Api-Token request.
VIDEOFIX_TOKEN=
